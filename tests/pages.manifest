# Page manifest — one row per renderable view. Single source of truth for the harness.
# Fields are TAB-separated:
#   id            short name used for baseline png + temp files
#   path          page file under platform/ + optional ?query (params the page needs to render data)
#   gl            webgl|leaflet  — which lib must initialise (drives the init-detection probe)
#   min_canvas    minimum count of non-trivial <canvas>/map containers expected after load
#   hooks         comma-separated element IDs that MUST exist & be non-empty after the page settles
#
# Notes on params:
#   branch-explorer needs ?lat=&lng=&n= (a real branch from data/branches.json[0]: x=lng,y=lat)
#   province needs ?p=<slug>; default slug is "rayong" (data/provinces/rayong.json must exist)
#   the two rayong-* pages self-load fixed JSON; no params needed
#
# Basemap raster tiles (cartocdn) are PROXY-BLOCKED -> they render blank. That is expected and
# the pixel-variance check tolerates it: geometry (buildings/polygons/scatter/text) still draws.

# index default tab is "Overview": it renders macro + region tables but does NOT create the Leaflet
# map (that's lazy-initialised only when the National tab is opened), so gl=none, min_canvas=0.
# hooks: #macro is the JS-populated macro strip (static-empty in index.html, filled from meta.json on
# render). The old second hook #region asserted the "Segment signals by region" table, which was
# REMOVED 2026-08-01 (owner directive: real numbers, not a score-of-a-score) — so #region no longer
# exists in the settled DOM and the health gate reported a false "missing #region" on every run.
index	index.html	none	0	macro
national	index.html#map	leaflet	1	map
# hooks: #trendregions is the region-mover list (JS-rendered from deltas.json, e.g. "Isan · 601
# branches"). The old hook #trendbaseline is the SINGLE-VINTAGE placeholder — it is empty in the
# shipped MULTI-vintage state (currently 2025M12 → 2026M06), so the gate reported a false
# "#trendbaseline empty" every run. If snapshot history is ever reset to a lone baseline vintage,
# the movers disappear and #trendbaseline fills — switch this hook back to trendbaseline then.
risk-trend	index.html#trend	none	0	trendregions
acquisition	index.html#acq	none	0	amptbl,amprtbl
branch-explorer	branch-explorer.html?lat=12.7506&lng=101.038&n=%E0%B8%A3%E0%B8%B0%E0%B8%A2%E0%B8%AD%E0%B8%87	webgl	1	map
province-rayong	province.html?p=rayong	webgl	1	map,kpis,v-districts
province-chonburi	province.html?p=chon-buri	webgl	1	map,kpis
# rayong-province.html is a RETIRED redirect stub (meta-refresh + location.replace -> /rayong-catchment,
# mirrored by a vercel.json permanent redirect). It has no WebGL scene, so it is intentionally NOT a
# manifest row — the harness only renders live views. The route was consolidated into rayong-catchment
# in f28d6df; the stub just keeps old deep-links/bookmarks alive.
rayong-catchment	rayong-catchment.html	webgl	1	map,focalName,leads,recos

# Data book — pure numbers page (no WebGL/Leaflet); reads data/regions.json + provinces/<slug>.json.
# gl=none, min_canvas=0. Two views: national overview and a province profile. NOTE: baseline PNGs are
# minted by the Linux CI/cloud render (NOT locally — Windows chromium AA would poison the committed
# baselines); until the first CI baseline run, the visual phase will flag these two rows.
data-book	data.html	none	0	db-root
data-book-province	data.html?p=rayong	none	0	db-root
