{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "platform",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "master": true
    }
  },
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"master\" ]; then exit 1; else exit 0; fi",
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    }
  ]
}
