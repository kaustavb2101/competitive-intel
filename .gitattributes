# Normalize line endings so pipeline scripts run on Kaustav's Windows laptop
# don't produce CRLF churn vs the LF-committed blobs (CI/Vercel are Linux).
# Repo is already LF, so adding this is a no-op for existing files; it only
# keeps future locally-written data/code files from flipping to CRLF.
* text=auto eol=lf

*.json      text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.md        text eol=lf
*.csv       text eol=lf
*.tsv       text eol=lf
*.geojson   text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.txt       text eol=lf

*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.xlsx      binary
*.xls       binary
*.zip       binary
*.pmtiles   binary
*.mbtiles   binary
*.parquet   binary
*.woff      binary
*.woff2     binary
*.ttf       binary

# Vendored third-party bundles (platform/vendor/) are byte-for-byte copies of the published
# npm/CDN files, and their SHA256 is recorded in platform/vendor/README.md so anyone can re-verify
# them against unpkg or jsdelivr. Line-ending normalisation would silently change those bytes and
# break that check, so this tree is exempt from every rule above.
platform/vendor/** -text
