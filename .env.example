# Copy this file to ".env" (same folder) and paste your real keys after each "=".
# The .env file is git-ignored — it stays on your machine and is NEVER committed.
# The pipeline scripts load it automatically (pipeline/envload.py), so you set
# these once and never have to export them again.
#
# ⚠️ NEVER put real key values in THIS file (.env.example) — it IS committed. Real
#    values go ONLY in .env (git-ignored). Placeholders below are intentional.
#
#   DATA_GO_TH_TOKEN   data.go.th open-data portal (vehicles / factories / crops)
#   NSO_TOKEN          National Statistical Office (population / labour force)
#   BOT_API_KEY_*      Bank of Thailand (interest rates / FX / macro stats)
#   GISTDA_API_KEY     GISTDA (Thai maps / boundaries / land use)
#   ORS_KEY            OpenRouteService (drive-time isochrones)
#   GOOGLE_PLACES_KEY  Google Places (competitor scout / geocoder)

DATA_GO_TH_TOKEN=your-data-go-th-token-here
NSO_TOKEN=your-nso-token-here
BOT_API_KEY_INTEREST=your-bot-interest-key-here
BOT_API_KEY_EXCHANGE=your-bot-exchange-key-here
BOT_API_KEY_STATS=your-bot-stats-key-here
GISTDA_API_KEY=your-gistda-key-here
ORS_KEY=your-ors-key-here
GOOGLE_PLACES_KEY=your-google-places-key-here

# GISTDA sphere key for 40m satellite crop-area (register free at sphere.gistda.or.th)
GISTDA_SPHERE_KEY=
