node_modules/
.vercel/

# local secrets — NEVER commit real keys (use .env.example as the template)
.env
*.env
!.env.example
__pycache__/
*.pyc
.DS_Store
.cache/

# enrichment-loop build artifacts (regenerate with pipeline/autox_enrich_loop.py)
pipeline/cache/
pipeline/iteration_log.json
pipeline/autox-branch-features.csv
pipeline/deck_payload.json

# desktop autopilot session log (pipeline/desktop_autopilot.ps1) — local-only, delete any time
pipeline/autopilot_log.txt

# raw gov-data pull — re-pullable INPUT CSVs (autox_dgt_ingest.py), never served.
# distilled layers live in source-data/; keep the bulk out of the tree.
pipeline/dgt_out/

# tiled, resumable national Overture pull — per-tile geojsonseq cache + resume manifest
# (pull_overture_national.py). Re-pullable raw INPUT; never commit synthetic geo or the cache.
source-data/.overture_tiles/
# merged national Overture PLACES layer (~54MB, pull_overture_places.py). Re-pullable raw INPUT;
# the DERIVED, small outputs (branch_occupations.json / amphoe_occupations.json) ARE committed and
# the gate skips the byte-check when this input is absent (CI never has it). Keep it local.
source-data/overture_places.json
# named-places bulk pull (pull_places_strip.py strips, merged) — raw INPUT for occupation_leads.json
# (the small DERIVED output IS committed). Re-pullable; keep local.
source-data/occupation_places_named.json

# QA render temp (headless screenshots)
platform/_qa_vendor/
platform/_qa_*.html

# test harness caches/work — regenerate with tests/run.sh (npm-installed deps + fresh renders).
# tests/baseline/*.png IS committed (visual-regression reference); everything else here is not.
tests/.cache/
tests/.work/
tests/node_modules/

# loan-tape synthetic scaffold — large + deterministically regenerable (pipeline/make_synthetic_tape.py)
source-data/loan_tape_synthetic.json
source-data/branch_aum_monthly_synthetic.json

# national building vector-tile artifacts (pipeline/build_building_tiles.py) — large, CDN-hosted,
# NEVER committed. Re-pullable real Overture data; coverage plan + .pmtiles/tiles live here.
pipeline/tiles_out/

# secrets — never commit (any .env or .env.txt anywhere)
.env
.env.txt
**/.env
**/.env.txt

# crop-type geodata scout scratch — raw re-pullable rasters/zips (SPAM/HDX), never commit
source-data/.crop_scout/

# data.go.th / NSO raw pull cache — bulk + re-pullable via pipeline/pull_datagoth.py (Thai IP only).
# The distilled province-keyed layers that downstream builders emit are what gets committed, not this.
source-data/datagoth/

# nightly cron wrapper logs (local only)
pipeline/cron_nightly.log
pipeline/cron_gate.out

# DOAE raw pull (re-pullable via pipeline/ingest_doae.py --pull)
source-data/doae_raw.json

# OAE yield raw CSVs — re-pullable via pipeline/pull_oae_yield.py; only the
# distilled source-data/oae_yield.json is committed, never the raw catalog CSVs.
source-data/.oae_yield_raw/

# OAE farm-economics raw PDF — re-pullable via pipeline/pull_oae_farm_economics.py
source-data/.oae_farm_econ_raw/

# BoT credit-quality raw (FSR2024.pdf + report984.html) — re-pullable via pipeline/pull_bot_credit.py;
# only the distilled source-data/bot_credit.json is committed, never the raw sources.
source-data/.bot_credit_raw/

# DLT raw catalog mirror (pull_dlt_all.py / pull_dlt_fuel.py) — re-pullable INPUT CSVs from
# gdcatalog.dlt.go.th; never committed (only the derived platform/data JSON is).
# (data.go.th probe output from pull_newcar_brandprovince.py lands in source-data/datagoth/,
#  already gitignored above.)
source-data/dlt/raw/

# NSO wage-anchor raw CSV — re-pullable via pipeline/pull_nso_wages.py; only the distilled
# source-data/nso_wages.json is committed, never the raw catalog CSV.
source-data/.nso_wage_raw/
.claude/settings.local.json

# Google Places ratings pull scratch cache
source-data/.place_ratings_cache.json

# Playwright MCP scratch (page snapshots / console logs)
.playwright-mcp/

# Thai-gov ingest wave raw downloads (PDFs/CSVs, 70MB+) — staging JSONs are the committed artifact
source-data/raw/

# gdcatalog.go.th full harvest (harvest_gdcatalog.py) — bulk raw datasets + OCR'd PDFs, re-pullable.
# The catalog INDEX (_catalog.jsonl) and manifest stay here too; nothing from the harvest is committed.
source-data/gdcatalog_harvest/
